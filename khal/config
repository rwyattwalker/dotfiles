[calendars]

[[personal]]
path = ~/.local/share/calendars/48D163DC-D097-11F0-B18F-A5328F890694/
color = dark green

[[anniversaries]]
path = ~/.local/share/calendars/b853fda1-4200-4725-8270-23d1283c4f03/
